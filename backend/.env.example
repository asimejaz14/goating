# Copy this file to backend/.env and fill in the values from your Supabase project.
# Supabase dashboard → Project Settings → Database / API.

# ---------------------------------------------------------------------------
# Database (Project Settings → Database → Connection string → URI)
# ---------------------------------------------------------------------------
# Use the **Session pooler** (port 5432) or the direct connection, and swap the
# scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Auth — the API signs its own tokens; there is no external identity provider.
# Users are rows in the `users` table (see supabase/migrations/0003_seed.sql),
# added by editing that file and re-running it, never through a signup screen.
# ---------------------------------------------------------------------------
# Generate a real secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# How long a signed-in session lasts before a partner has to log in again.
JWT_EXPIRE_DAYS=60

# ---------------------------------------------------------------------------
# Farm settings
# ---------------------------------------------------------------------------
# Tag numbers are built as <PREFIX>-<BREED CODE>-<NN>, e.g. BGF-MC-01.
FARM_PREFIX=BGF
# Average goat gestation; drives the expected kidding date and the countdown.
GESTATION_DAYS=150
CURRENCY_CODE=PKR
CURRENCY_SYMBOL=₨

# ---------------------------------------------------------------------------
# Where the frontend runs (comma-separated)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
