# Copy to .env.local and fill in. Every value here is public by design —
# NEXT_PUBLIC_* is baked into the browser bundle, so never put a service-role
# key or the JWT secret in this file.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the FastAPI backend is listening.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Storage bucket that holds goat photos (created by supabase/migrations/0003).
NEXT_PUBLIC_PHOTO_BUCKET=goat-photos
